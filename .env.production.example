# Production environment template for www.ocuosh.com
# Copy these names into the deployment host's secret/environment manager.
# Do not commit real secret values.

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://www.ocuosh.com

# MySQL-compatible database used by Drizzle.
# Example shape:
# DATABASE_URL=mysql://user:password@host:4000/database?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Authentication and administration.
JWT_SECRET=
ADMIN_PASSWORD=

# Optional LLM/Forge configuration, required only if chat or AI-assisted update features are enabled.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional Manus OAuth/user environment values, if the active deployment enables Manus user authentication.
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
